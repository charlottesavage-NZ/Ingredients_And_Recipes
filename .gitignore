# (The leading / means "only the one in the project folder" - without
# it, files with the same name inside node_modules, which the database
# driver needs, would be left out of git too.)
/credentials.js

# Azure SQL connection details (server, login, password) - only on the
# garage. Creating it switches the site from the CSV files to the
# database - see database.js and database-config.example.js.
/database-config.js

# Downloaded libraries (Playwright, the SQL Server driver). Not kept in
# git - they're downloaded from package.json / package-lock.json with
# "npm ci" instead (on the garage: after an update that changes them).
# Being listed here also means the garage's hourly "git clean -fd"
# leaves them alone.
node_modules/

# Live household data - the garage server owns these, so a pull
# must never overwrite them with the copies from this computer
*.csv

# Half-finished saves from writeFileSafely() in server.js
*.tmp

# Who is logged in on which browser - see the LOGIN section in server.js.
# Must stay out of git, or the hourly update would delete it and log everyone out.
sessions.json

# When the morning watch list price check last ran - see WATCH LIST in server.js.
watch_check_status.json
.claude/launch.json
